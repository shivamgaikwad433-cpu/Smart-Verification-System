DATABASE_URL="file:./dev.db"
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-long-random-string
# Gmail address and Google App Password (not your normal Gmail password).
EMAIL_USER=
EMAIL_PASS=
OTP_SECRET=replace-with-a-long-random-string
EMAIL_PROOF_SECRET=replace-with-a-long-random-string
EMAIL_PROOF_TTL_SECONDS=900
ALLOWED_EMAIL_DOMAINS=
OTP_DEV_LOG=true
FRONTEND_URL=http://localhost:5173
PORT=8080
APP_URL=http://localhost:5173
NODE_ENV=development
EMAIL_DRIVER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_FROM=
OTP_TTL_SECONDS=20
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=15
OTP_MAX_SENDS_PER_HOUR=5
REQUIRE_LOGIN_OTP=false
# 20 seconds is too short for slow email delivery; use 120-300 in real deployments.

